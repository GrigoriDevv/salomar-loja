# Copie para .env na raiz:  cp .env.docker.example .env
# Gere cada segredo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   (ou: openssl rand -base64 32)

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32 bytes em base64. Guarde com cuidado: perder a chave = perder os CPFs cifrados.
FIELD_ENCRYPTION_KEY=
# Senha do admin criado pelo seed (admin@salomar.com.br por padrão)
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@salomar.com.br

# Endereços vistos pelo navegador (mude se trocar as portas)
# WEB_URL=http://localhost:5173
# API_URL=http://localhost:3000
# WEB_PORT=5173
# API_PORT=3000
# POSTGRES_PASSWORD=salomar

# Mercado Pago — use as credenciais DE TESTE enquanto valida
# MP_ACCESS_TOKEN=TEST-...
# VITE_MP_PUBLIC_KEY=TEST-...
# MP_WEBHOOK_SECRET=

# E-mails (opcional): Resend
# RESEND_API_KEY=
# RESEND_FROM=Salomar <pedidos@seudominio.com.br>
# STORE_NOTIFY_EMAIL=loja@seudominio.com.br
