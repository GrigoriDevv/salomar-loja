DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salomar?schema=public
CORS_ORIGIN=http://localhost:5173
PORT=3000

# 32 bytes em base64 — gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Smoke de backup cifrado (npm run backup:verify)
# BACKUP_TEST_PASSPHRASE=change-me-local-only

# Seed admin (POST /auth/login). Em produção, defina senha forte.
SEED_ADMIN_EMAIL=admin@salomar.com.br
SEED_ADMIN_PASSWORD=SalomarAdmin!2026
# SEED_ADMIN_RESET=1
